---
import BaseLayout from "../layouts/BaseLayout.astro";

const hero = {
  photo: "/profil.png",
  name: "Axel Refalo",
  roles: [
    `Master in <strong>Automation Engineering</strong> at École de Technologie Supérieure`,
    `Master and Bachelor of <strong>Mechanical Engineering</strong> at University of Technology of Belfort-Montbéliard`,
  ],
  bio: [
    `Master's student in <strong>Automation Engineering</strong>, I am currently pursuing my master's thesis at the <strong>Control and Robotics Laboratory</strong> of <strong>École de technologie supérieure</strong> (Canada), under the supervision of Prof. <strong>Ilian Bonev</strong> and Prof. <strong>Clément Gosselin</strong>. My research explores serial manipulator morphologies, the arrangement of the joint axes, and their implications on the industrial performance of the arms. With unconventional and custom-built robots, the question of controllability at the design stage really matters to industrial robot manufacturers.`,
    `Alongside the thesis I have worked in collaboration with other laboratories. I implemented a Kalman filter for positioning from satellite signals of opportunity, and a tomographic reconstruction pipeline for synchrotron scans of concrete, both at <strong>École de technologie supérieure</strong>. And on <strong>HORTIS</strong> at the <strong>McGill Bioresource Engineering Lab</strong>, we designed and built the robotic gantry that captures the plant growth data.`,
    `Before Montréal I received an engineering degree in <strong>Mechanical Engineering</strong>, specializing in mechatronics, from the <strong>University of Technology of Belfort-Montbéliard</strong> (France), and did an internship at <strong>Canon Production Printing R&D</strong> (Netherlands) under the supervision of Dr. <strong>Karel Knechten</strong>. It introduced me to robotics research, developing two Cartesian robots for microscopic inspection of print heads.`,
    `Beyond this, I actively develop design, hardware and software for robotics projects out of curiosity.`,
  ],
  links: [
    { label: "CV",       href: "/cv.pdf",                                              icon: "fa-regular fa-file",       type: "pdf"      },
    { label: "LinkedIn", href: "https://www.linkedin.com/in/axel-refalo-3b4838228/",   icon: "fa-brands fa-linkedin-in",  external: true   },
    { label: "GitHub",   href: "https://github.com/axelrefalo",                        icon: "fa-brands fa-github",       external: true   },
    { label: "GrabCAD",  href: "https://grabcad.com/axel.refalo-1",                    icon: "fa-solid fa-cube",          external: true   },
    { label: "Email",    href: "mailto:axel.refalo.1@ens.etsmtl.ca",                   icon: "fa-regular fa-envelope"                     },
  ],
};

const publications = [
  {
    title:   "Singularity Analysis of Fanuc's CRX Series",
    authors: "Refalo, A., Mac Leod, P., Bonev, I., and Gosselin, C.",
    venue:   "In preparation for ICRA 2027",
    media:   { type: "image", src: "/media/publications/singularity-analysis-crx.png", zoomable: true },
    tag:     "Publication",
  },
  {
    title:   "Singularity Analysis of ABB's GoFa 5 Robot Arm",
    authors: "Refalo, A., Bonev, I., and Gosselin, C.",
    venue:   "IEEE ICRA 2026",
    media:   { type: "image", src: "/media/publications/singularity-analysis.png", zoomable: true },
    link:    { href: "/media/publications/icra2026-poster.pdf", type: "pdf", icon: "fa-regular fa-file" },
    tag:     "Publication",
  },
  {
    title:   "HORTIS: An Open-Source Robotic Framework for Controlled Environment Agriculture with Multimodal Spatiotemporal Plant Observation",
    authors: "Debbagh, M., Refalo, A., et al.",
    venue:   "In preparation",
    media:   { type: "video", src: "/media/publications/plant-growth.mov" },
    link:    { href: "https://github.com/Controlled-Hydroponics-Imaging-Platform", type: "external", icon: "fa-brands fa-github" },
    tag:     "Publication",
  },
  {
    title:   "R&D at Canon Production Printing",
    venue:   "2023–2024",
    media:   { type: "image", src: "/media/publications/canonnhq.jpg", zoomable: true },
    description: "Cartesian robots for inspecting static microscopic print nozzle defects and dynamic ink behavior on the coating surface.",
    tag:     "Internship",
  },
];

const coursework = [
  {
    title:       "Applied Machine Learning",
    institution: "McGill University",
    year:        2025,
    media:       { type: "image", src: "/media/coursework/AttentionIsAllYouNeed.png", zoomable: true, fit: "contain" },
    link:        { href: "https://github.com/axelrefalo/applied-machine-learning-w2025", type: "external", icon: "fa-brands fa-github" },
    description: "Python projects in pattern recognition and classification: regression, KNN, decision trees, neural networks, and LLMs.",
  },
  {
    title:       "Applied Robotics",
    institution: "McGill University",
    year:        2024,
    media:       { type: "video", src: "/media/coursework/applied-robotics.mp4" },
    link:        { href: "https://github.com/axelrefalo/applied-robotics-f2024", type: "external", icon: "fa-brands fa-github" },
    description: "Implemented controller packages on ROS1 with Gazebo in C++ for dynamic and kinematic control of the Kinova Gen3, a redundant robotic arm.",
  },
  {
    title:       "Quadrotor Control",
    institution: "École de Technologie Supérieure",
    year:        2024,
    media:       { type: "video", src: "/media/coursework/mrac-quadrotor.mp4" },
    link:        { href: "/media/coursework/rapport-mrac-quadrotor.pdf", type: "pdf", icon: "fa-regular fa-file" },
    description: "Design and implemented a Model Reference Adaptive Control for a quadrotor on MATLAB.",
  },
  {
    title:       "Watch Movement",
    institution: "University of Technology of Belfort-Montbéliard",
    year:        2023,
    media:       { type: "image", src: "/media/coursework/eta6497.png", zoomable: true },
    link:        { href: "https://grabcad.com/library/eta6497-1", type: "external", icon: "fa-solid fa-cube" },
    description: "Replication of the ETA6497, a Swiss watch mechanism, design of parametric gears with a cycloidal profile on CATIA V5.",
  },
  {
    title:       "Truss Simulator",
    institution: "University of Technology of Belfort-Montbéliard",
    year:        2022,
    media:       { type: "image", src: "/media/projects/truss-simulator.png", zoomable: true },
    link:        { href: "https://axelrefalo.github.io/Projet-MN41/web/truss-simulator.html", type: "external", icon: "fa-solid fa-arrow-up-right-from-square" },
    description: "Mechanical truss simulator using finite element methods in C#.",
  },
];

const projects = [
  {
    title: "IKDH: An Inverse Kinematic solver based on Denavit and Hartenberg convention",
    year:  2026,
    media: { type: "image", src: "/media/projects/ikdh.gif", zoomable: true },
    link:  { href: "https://lab-coro.github.io/IKDH/web/ikdh.html", type: "external", icon: "fa-solid fa-arrow-up-right-from-square" },
    description: "Inverse kinematics solver that outputs all the inverse kinematics solutions for a six revolute personalized robot arm and enables singularity analysis.",
    tag:   "IKDH",
  },
  {
    title: "Cable-Driven Plotter",
    year:  2026,
    media: { type: "image", src: "/media/projects/PolarGraffiti.png", zoomable: true, fit: "contain" },
    description: "Two-cable-driven parallel plotter for spray painting: dynamic model derived analytically, validated and implemented.",
    tag:   "Cable-Driven Plotter",
  },
  {
    title: "Home Server",
    year:  2025,
    media: { type: "image", src: "/media/projects/home-server.png", zoomable: true },
    link:  { href: "https://grabcad.com/library/rpi5-nas-case-1", type: "external", icon: "fa-solid fa-cube" },
    description: "Home lab server built and accessed remotely using Unix Shell.",
    tag:   "Home Server",
  },
  {
    title: "Serial Manipulator",
    year:  2024,
    media: { type: "image", src: "/media/projects/sacha.png", zoomable: true, fit: "contain" },
    link:  { href: "https://grabcad.com/library/sacha-3dof-robot-arm-1", type: "external", icon: "fa-solid fa-cube" },
    description: "Three-degree-of-freedom manipulator with parallelogram mechanism, for pick-and-place tasks, forward and inverse kinematics derived analytically and implemented.",
    tag:   "Serial Manipulator",
  },
  {
    title: "Puzzle Grid Solver",
    year:  2023,
    media: { type: "image", src: "/media/projects/puzzle-grid-solver.png", zoomable: true, fit: "contain" },
    link:  { href: "https://axelrefalo.github.io/puzzle-grid-solver/", type: "external", icon: "fa-solid fa-arrow-up-right-from-square" },
    description: "Algorithms to solve complex grid puzzles: sudoku, kakuro, killer sudoku, suguru, using a backtracking method in C++.",
    tag:   "Puzzle Grid Solver",
  },
  {
    title: "Fluid Simulator",
    year:  2023,
    media: { type: "video", src: "/media/projects/fluid-simulator.mov" },
    link:  { href: "https://axelrefalo.github.io/eulerian-fluid-simulator/web/fluid_simulator.html", type: "external", icon: "fa-solid fa-arrow-up-right-from-square" },
    description: "Simple Eulerian fluid simulator in C++ with the SFML library.",
    tag:   "Fluid Simulator",
  },
];
---

<BaseLayout>
  <div class="container">

    <section id="home">
      <div class="hero-top">
        <div class="hero-photo">
          <img src={hero.photo} alt={hero.name} />
        </div>
        <div class="hero-info">
          <div class="hero-name">{hero.name}</div>
          {hero.roles.map((r) => <div class="hero-role" set:html={r} />)}
        </div>
      </div>
      <div class="text-separator">
        <svg viewBox="0 0 300 20" class="separator-svg" aria-hidden="true">
          <path d="M0 10 Q65 10 136 7 L136 13 Q65 10 0 10 Z" />
          <circle cx="150" cy="10" r="4" />
          <path d="M300 10 Q235 10 164 7 L164 13 Q235 10 300 10 Z" />
        </svg>
      </div>
      <div class="hero-footer">
        {hero.bio.map((para) => <p class="hero-bio" set:html={para} />)}
        <div class="contact-links">
          {hero.links.map((link) => (
            <a
              class={`contact-link${link.type === "pdf" ? " pdf-link" : ""}`}
              href={link.href}
              target={link.external ? "_blank" : undefined}
              title={link.label}
            >
              <i class={link.icon}></i>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section>
      <div class="section-label">Research</div>
      <div class="card-list">
        {publications.map((item) => (
          <div class="card-item">
            <div class="card-media">
              {item.media.type === "image" ? (
                <img src={item.media.src} alt={item.title} class={`${item.media.zoomable ? "zoomable" : ""}${item.media.fit === "contain" ? " contain" : ""}`} />
              ) : (
                <video
                  src={item.media.src}
                  autoplay muted loop playsinline
                  class="zoomable"
                  data-speed={item.media.speed}
                ></video>
              )}
            </div>
            <div class="card-content">
              <div class="card-top-row">
                {item.tag && <div class="card-tag">{item.tag}</div>}
                {item.link && (
                  <a
                    class={`card-link-icon${item.link.type === "pdf" ? " pdf-link" : ""}`}
                    href={item.link.href}
                    target={item.link.type === "pdf" ? undefined : "_blank"}
                  >
                    <i class={item.link.icon}></i>
                  </a>
                )}
              </div>
              <div class="card-title"><strong>{item.title}</strong></div>
              {item.description && <div class="card-description">{item.description}</div>}
              {item.authors && <div class="card-authors">{item.authors}</div>}
              <div class="card-venue">{item.venue}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section>
      <div class="section-label">Projects</div>
      <div class="card-list">
        {projects.map((item) => (
          <div class="card-item">
            <div class="card-media">
              {item.media.type === "image" ? (
                <img src={item.media.src} alt={item.title} class={`${item.media.zoomable ? "zoomable" : ""}${item.media.fit === "contain" ? " contain" : ""}`} />
              ) : (
                <video
                  src={item.media.src}
                  autoplay muted loop playsinline
                  class="zoomable"
                  data-speed={item.media.speed}
                ></video>
              )}
            </div>
            <div class="card-content">
              <div class="card-top-row">
                {item.tag && <div class="card-tag">{item.tag}</div>}
                {item.link && (
                  <a class="card-link-icon" href={item.link.href} target="_blank">
                    <i class={item.link.icon}></i>
                  </a>
                )}
              </div>
              {item.description && <div class="card-description">{item.description}</div>}
              <div class="card-venue">{item.year}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section>
      <div class="section-label">Coursework</div>
      <div class="card-list">
        {coursework.map((item) => (
          <div class="card-item">
            <div class="card-media">
              {item.media.type === "image" ? (
                <img src={item.media.src} alt={item.title} class={`${item.media.zoomable ? "zoomable" : ""}${item.media.fit === "contain" ? " contain" : ""}`} />
              ) : (
                <video
                  src={item.media.src}
                  autoplay muted loop playsinline
                  class="zoomable"
                  data-speed={item.media.speed}
                ></video>
              )}
            </div>
            <div class="card-content">
              <div class="card-top-row">
                <div class="card-tag">{item.institution}</div>
                {item.link && (
                  <a
                    class={`card-link-icon${item.link.type === "pdf" ? " pdf-link" : ""}`}
                    href={item.link.href}
                    target={item.link.type === "pdf" ? undefined : "_blank"}
                  >
                    <i class={item.link.icon}></i>
                  </a>
                )}
              </div>
              <div class="card-title"><strong>{item.title}</strong></div>
              {item.description && <div class="card-description">{item.description}</div>}
              <div class="card-venue">{item.year}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>

  <div id="lightbox" class="lightbox">
    <img id="lightbox-img" src="" alt="" />
    <video id="lightbox-video" src="" autoplay muted loop playsinline></video>
  </div>

  <div id="cv-modal" class="cv-modal">
    <div class="cv-modal-inner">
      <iframe id="cv-frame" src="" title="CV"></iframe>
    </div>
  </div>
</BaseLayout>

<style>

  .container {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 40px;
  }

  section {
    padding: 20px 0;
    border-bottom: 1px solid #e8e8e8;
  }

  section:last-child {
    border-bottom: none;
  }

  #home {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: none;
  }

  .hero-top {
    display: flex;
    width: 100%;
    gap: 40px;
    align-items: center;
  }

  .hero-info {
    flex: 1;
    min-width: 0;
    width: 100%;
  }


  .hero-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: #e8e8e8;
    flex-shrink: 0;
    overflow: hidden;
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-name {
    font-size: 30px;
    font-weight: 700;
    color: #111;
    line-height: 1.2;
    margin-bottom: 6px;
  }

  .hero-role {
    font-size: 15px;
    line-height: 1.7;
    color: #333;
    text-align: justify;
  }

  .hero-footer {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 12px;
  }

  .hero-bio {
    font-size: 15px;
    color: #333;
    line-height: 1.7;
    text-align: justify;
  }

  .hero-bio + .hero-bio {
    margin-top: 6px;
  }

  .section-label {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 28px;
  }

  .contact-links {
    display: flex;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
    margin-top: 16px;
  }


  .contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    font-size: 13px;
    color: #111;
    text-decoration: none;
    background: #f0f0f0;
    border-radius: 4px;
    transition: opacity 0.15s;
  }

  .contact-link:hover { opacity: 0.5; }

  .text-separator {
    display: none;
    justify-content: center;
    margin-top: 20px;
  }

  .separator-svg {
    width: 220px;
    height: 16px;
    fill: #ccc;
  }

  .card-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .card-item {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .card-media {
    width: 200px;
    height: 130px;
    flex-shrink: 0;
    background: #f0f0f0;
    overflow: hidden;
    border-radius: 4px;
  }

  .card-media img,
  .card-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-media img.zoomable {
    cursor: zoom-in;
  }

  .card-media img.contain {
    object-fit: contain;
    background: #fff;
  }

  .card-content {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
    padding-top: 4px;
  }

  .card-top-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
  }

  .card-tag {
    display: flex;
    align-items: center;
    flex: 1;
    min-height: 28px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #666;
    background: #f0f0f0;
    border-radius: 4px;
  }

  .card-title {
    font-size: 15px;
    color: #111;
    line-height: 1.4;
  }

  .card-link-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-left: auto;
    flex-shrink: 0;
    color: #111;
    font-size: 13px;
    text-decoration: none;
    background: #f0f0f0;
    border-radius: 4px;
    transition: opacity 0.15s;
  }

  .card-link-icon:hover {
    opacity: 0.5;
  }

  .card-authors {
    font-size: 12px;
    color: #999;
  }

  .card-venue {
    font-size: 12px;
    color: #999;
  }

  .card-description {
    font-size: 14px;
    color: #333;
    line-height: 1.5;
    text-align: justify;
    margin-top: 4px;
    margin-bottom: 2px;
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    z-index: 100;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
  }

  .lightbox.open { display: flex; }

  .lightbox img,
  .lightbox video {
    max-width: 80vw;
    max-height: 80vh;
    border-radius: 4px;
    box-shadow: 0 8px 40px rgba(0,0,0,0.4);
    object-fit: contain;
  }

  #lightbox-video { display: none; }

  .cv-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    z-index: 100;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
  }

  .cv-modal.open { display: flex; }

  .cv-modal-inner {
    width: 75vw;
    height: 85vh;
    cursor: default;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0,0,0,0.4);
  }

  .cv-modal-inner iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  @media (max-width: 600px) {
    .container { padding: 0 20px; }
    #home { flex-direction: column; gap: 24px; }
    .hero-top { flex-direction: column; align-items: flex-start; gap: 16px; }
    .hero-photo { width: 88px; height: 88px; }
    .contact-links { gap: 12px; }
    .card-item { flex-direction: column; }
    .card-media { width: 100%; height: auto; aspect-ratio: 200 / 130; }
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxVideo = document.getElementById('lightbox-video');

  document.querySelectorAll('img.zoomable').forEach(img => {
    img.addEventListener('click', () => {
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightboxImg.style.display = 'block';
      lightboxVideo.style.display = 'none';
      lightboxVideo.src = '';
      lightbox.classList.add('open');
    });
  });

  document.querySelectorAll('video.zoomable').forEach(video => {
    if (video.dataset.speed) video.playbackRate = parseFloat(video.dataset.speed);
    video.addEventListener('click', () => {
      lightboxVideo.src = video.src;
      lightboxVideo.style.display = 'block';
      lightboxImg.style.display = 'none';
      lightboxImg.src = '';
      lightbox.classList.add('open');
    });
  });

  lightbox.addEventListener('click', () => {
    lightbox.classList.remove('open');
    lightboxVideo.src = '';
  });

  const cvModal = document.getElementById('cv-modal');
  const cvFrame = document.getElementById('cv-frame');

  document.querySelectorAll('a.pdf-link').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      cvFrame.src = link.href;
      cvModal.classList.add('open');
    });
  });

  cvModal.addEventListener('click', (e) => {
    if (!e.target.closest('.cv-modal-inner')) {
      cvModal.classList.remove('open');
      cvFrame.src = '';
    }
  });
</script>
